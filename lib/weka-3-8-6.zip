                })
                .join("&");
            return url + "?" + params;
        }

        
        function loadimg(params, dimension_prefix) {
            params = Object.assign({"idsite":1,"rec":1,"rand":176,"dimension2":"pg_dwnld","url":"https://sourceforge.net/projects/weka/files/weka-3-8/3.8.6/weka-3-8-6.zip/download","action_name":"Download weka-3-8-6.zip (Weka)"}, params);
